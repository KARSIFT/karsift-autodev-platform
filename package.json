{
  "name": "@karsift/autodev-control-plane",
  "version": "0.1.0",
  "private": true,
  "description": "KARSIFT Autodev Platform control plane foundation",
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test \"dist/**/*.test.js\"",
    "start": "node dist/main.js",
    "migrate": "node dist/db/migrate.js",
    "verify:postgres": "node scripts/verify-postgres-foundation.mjs",
    "verify:queue": "node scripts/verify-work-queue.mjs",
    "check": "npm run build && npm test",
    "verify:freshness": "node scripts/verify-freshness-validation.mjs"
  },
  "dependencies": {
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.20.0",
    "typescript": "7.0.2"
  }
}
