# Public DNS hostname pointing to the VPS.
CONTROL_PLANE_DOMAIN=control.example.com

# Database identity. Replace every CHANGEME value before deployment.
POSTGRES_DB=karsift_autodev
POSTGRES_USER=karsift
POSTGRES_PASSWORD=CHANGEME
DATABASE_URL=postgresql://karsift:CHANGEME@postgres:5432/karsift_autodev

# Control Plane identities and bearer credentials.
CONTROL_PLANE_SERVICE_ID=karsift-control-plane
CONTROL_PLANE_FOUNDER_ID=founder
CONTROL_PLANE_API_TOKEN=CHANGEME
CONTROL_PLANE_FOUNDER_API_TOKEN=CHANGEME_DIFFERENT
CONTROL_PLANE_FOUNDER_INTERFACE_API_TOKEN=CHANGEME_INTERFACE
